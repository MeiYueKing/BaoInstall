<?xml version="1.0" encoding="utf-8"?>
<!--
  图标概念：一个"装进去"的包裹框 + 向下的箭头。
  圆角方框代表容器（安装落点），箭头代表写入，底边是完成线。
  图形控制在画布中间 48dp 内，圆形 / 方圆遮罩下都不会被裁到。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外框 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M42,30 L66,30 A12,12 0 0 1 78,42 L78,66 A12,12 0 0 1 66,78 L42,78 A12,12 0 0 1 30,66 L30,42 A12,12 0 0 1 42,30 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="7" />

    <!-- 箭头轴线 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,40 L54,56"
        android:strokeColor="#FF6EE7B7"
        android:strokeLineCap="round"
        android:strokeWidth="6" />

    <!-- 箭头头部 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M46,50 L54,58 L62,50"
        android:strokeColor="#FF6EE7B7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="6" />

    <!-- 完成线 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M44,68 L64,68"
        android:strokeColor="#FF6EE7B7"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
</vector>
