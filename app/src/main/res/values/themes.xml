<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Bao" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 安装确认弹窗：透明窗口 + 外部变暗，覆盖在调用方界面之上 -->
    <style name="Theme.Bao.Dialog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 用对话框的淡入+缩放，而不是 Activity 的页面切换动画 -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>